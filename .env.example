# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=library.example.com
SITE_URL=https://library.example.com
CSRF_TRUSTED_ORIGINS=https://library.example.com
MEDIA_ROOT=/srv/library/media

# MFA
MFA_ISSUER=Library
MFA_ENCRYPTION_KEYS=replace-with-primary-fernet-key
# During rotation: MFA_ENCRYPTION_KEYS=new-key,previous-key
# Production forces MFA for all users.

# Database
DB_NAME=library
DB_USER=library_app
DB_PASSWORD=replace-runtime-password
# Deployment-only account with schema migration privileges; never use in web/worker runtime.
DB_MIGRATION_USER=library_migrator
DB_MIGRATION_PASSWORD=replace-migration-password
DJANGO_MIGRATION_MODE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=library@example.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=library@example.com

# Library Cover/PDF storage on the download host (FTPS)
LIBRARY_CDN_STORAGE=ftp
LIBRARY_CDN_BASE_URL=https://cdn.example.com/library/
LIBRARY_CDN_FTP_HOST=ftp.example.com
LIBRARY_CDN_FTP_PORT=21
LIBRARY_CDN_FTP_USER=library-uploader
LIBRARY_CDN_FTP_PASSWORD=replace-with-download-host-password
LIBRARY_CDN_FTP_ROOT=public_html/library
LIBRARY_CDN_FTP_TLS=true
LIBRARY_CDN_FTP_PASSIVE=true
LIBRARY_CDN_FTP_TIMEOUT=30
# Filesystem fallback for local/offline development only:
LIBRARY_CDN_ROOT=/srv/library/cdn

# Security
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
LOG_LEVEL=INFO
TRUST_X_FORWARDED_FOR=true
METRICS_TOKEN=replace-with-random-operations-token
BACKGROUND_WORKER_MAX_AGE_SECONDS=120
BACKGROUND_JOB_LOCK_TIMEOUT_SECONDS=3600
BACKGROUND_JOB_RETENTION_DAYS=30

# Session
SESSION_COOKIE_AGE=604800
