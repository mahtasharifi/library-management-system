upstream library_web {
    server web:8000;
    keepalive 32;
}

# Reject unknown Host headers instead of redirecting/serving them.
server {
    listen 8080 default_server;
    server_name _;
    return 444;
}

server {
    listen 8080;
    server_name ${LIBRARY_DOMAIN};
    return 308 https://${LIBRARY_DOMAIN}$request_uri;
}

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name _;
    server_tokens off;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${LIBRARY_DOMAIN};
    server_tokens off;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 110m;
    client_body_timeout 30s;
    keepalive_timeout 65s;

    location /static/ {
        alias /srv/static/;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /media/library_cdn/ {
        alias /srv/cdn/;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
    }

    location /media/ {
        alias /srv/media/;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        proxy_pass http://library_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # This deployment has one trusted Nginx hop; overwrite client-supplied XFF.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
    }
}
