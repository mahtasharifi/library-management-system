DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_ALLOWED_HOSTS=library.example.com
SITE_URL=https://library.example.com
CSRF_TRUSTED_ORIGINS=https://library.example.com
MEDIA_ROOT=/srv/library/media
MFA_ENCRYPTION_KEYS=replace-with-primary-fernet-key
DB_NAME=library
DB_USER=library_runtime
DB_PASSWORD=replace-runtime-password
DB_HOST=private-db.internal
DB_PORT=3306
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=library@example.com
EMAIL_HOST_PASSWORD=replace-email-password
DEFAULT_FROM_EMAIL=library@example.com
LIBRARY_CDN_STORAGE=ftp
LIBRARY_CDN_BASE_URL=https://cdn.example.com/library/
LIBRARY_CDN_FTP_HOST=ftp.example.com
LIBRARY_CDN_FTP_PORT=21
LIBRARY_CDN_FTP_USER=library-uploader
LIBRARY_CDN_FTP_PASSWORD=replace-with-download-host-password
LIBRARY_CDN_FTP_ROOT=public_html/library
LIBRARY_CDN_FTP_TLS=true
LIBRARY_CDN_FTP_PASSIVE=true
LIBRARY_CDN_FTP_TIMEOUT=30
LIBRARY_CDN_ROOT=/srv/library/cdn
METRICS_TOKEN=replace-with-random-operations-token
TRUST_X_FORWARDED_FOR=true

BACKGROUND_JOB_LOCK_TIMEOUT_SECONDS=3600
